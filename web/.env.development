# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 应用版本号
VITE_VERSION = 0.0.0

# 开发服务器端口
VITE_PORT = 5173

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /dev-api

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
VITE_API_PROXY_URL = http://localhost:8081

# Delete console
VITE_DROP_CONSOLE = false

# 菜单模式：frontend（静态路由）| backend（后端接口）
VITE_ACCESS_MODE = frontend
